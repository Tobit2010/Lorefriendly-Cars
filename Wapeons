-- Function to give player a weapon from the list
RegisterCommand('giveweapon', function(source, args, rawCommand)
    local weaponName = args[1] -- Get the weapon name from arguments
    if table.contains(weaponCodes, weaponName) then
        GiveWeaponToPed(GetPlayerPed(-1), GetHashKey(weaponName), 1, false, true)
        TriggerEvent('chat:addMessage', {
            args = { "You have received: " .. weaponName }
        })
    else
        TriggerEvent('chat:addMessage', {
            args = { "Invalid weapon name!" }
        })
    end
end, false)

-- Helper function to check if a table contains a value
function table.contains(table, value)
    for i=1, #table do
        if table[i] == value then
            return true
        end
    end
    return false
end
